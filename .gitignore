# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero la plantilla SÍ se versiona: es la documentación de qué variables hace falta
# configurar y no contiene ningún valor. Sin ella, un dev nuevo no puede arrancar.
!.env.example

# vercel
.vercel

# claude code local state (machine-specific, not meant to be shared)
.claude/settings.local.json
.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# cache de Python
__pycache__/
# estado local del CLI de Supabase (no es configuracion del repo)
supabase/.temp/

# volcados de entorno (p.ej. prod.env de `vercel env pull`): .env* no los cubre
*.env

# Artefacto de una corrida del banco adversario: trae las respuestas del modelo, cambia en cada
# corrida y no es fuente. Lo que se conserva es el informe curado en docs/AGENTE-ADVERSARIOS.md.
adversarios/informe.json
