# ==========================================================================================
# METODOLOGIA DE ENTORNOS (importante): en DESARROLLO estas credenciales apuntan SIEMPRE al
# proyecto de dev (tuvetia-athos-dev), NUNCA al proyecto principal/compartido. Las credenciales
# del principal solo viven en CI / secretos. Detalle: docs/MIGRACIONES.md
# ==========================================================================================

# Supabase (proyecto de DEV — tuvetia-athos-dev)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...          # SECRETA. Solo servidor.
SUPABASE_JWT_SECRET=...                 # Project Settings -> API -> JWT Settings
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Motores de IA (siempre por env var). Proveedor conmutable:
#   anthropic -> LLM_MODEL=claude-sonnet-5, LLM_API_KEY=<anthropic>
#   openai    -> compatible (DeepSeek/Kimi): LLM_PROVIDER=openai, LLM_BASE_URL=https://api.deepseek.com,
#                LLM_MODEL=deepseek-chat, LLM_API_KEY=<deepseek>
LLM_PROVIDER=openai                     # anthropic | openai   (default: openai/DeepSeek)
LLM_BASE_URL=https://api.deepseek.com   # solo para openai-compatible
LLM_MODEL=deepseek-v4-flash             # el validado contra el golden set
LLM_LIGHT_MODEL=deepseek-v4-flash
LLM_API_KEY=...                         # console.anthropic.com | platform.deepseek.com

# --- Gemini (Google). Key y base URL propias para que convivan con el primario sin pisarlo. ---
# Se usa por su endpoint COMPATIBLE con OpenAI, asi que no agrega dependencias.
GEMINI_API_KEY=                         # aistudio.google.com/apikey
GEMINI_BASE_URL=                        # vacio -> https://generativelanguage.googleapis.com/v1beta/openai
# El modelo de Gemini NO tiene variable propia: va dentro del string de la cascada, p. ej.
# LLM_CASCADE_REDACCION="deepseek-v4-flash@openai,gemini-3.6-flash@google". Las antiguas
# GEMINI_MODEL / GEMINI_LIGHT_MODEL no las leia nadie y se eliminaron (auditoria 2026-07-30).

# --- CASCADA ENTRE PROVEEDORES (clausula 1.4) y ROUTING POR TAREA (1.5) ---
# NO confundir con app/retrieval/cascade.py, que es la cascada de RECUPERACION de documentos.
#
# Formato: "modelo@proveedor,modelo@proveedor" en orden de preferencia. El primero atiende; los
# siguientes SOLO se usan si el anterior falla (caida, timeout, limite de tasa, saldo agotado).
#
# QUE PASA SI SE DEJA VACIO: nada. Se usa el proveedor de siempre, sin alternativas y sin una sola
# llamada extra. Es el interruptor para volver al comportamiento anterior sin desplegar.
#
# ADVERTENCIA: no pongas anthropic en la lista mientras su cuenta no tenga credito. Cada intento
# suyo agrega una llamada fallida y su latencia antes de llegar al proveedor que si responde.
LLM_CASCADE_REDACCION=                  # chat y nota del Fantasma
LLM_CASCADE_LIVIANO=                    # A->B, juez de evidencia, auditores
LLM_CASCADE_MAX_INTENTOS=3
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-v4.0              # Cohere (verifica el ID exacto en docs de Cohere)
EMBEDDING_DIM=1024                      # DEBE coincidir con la columna vector de la DB
EMBEDDING_API_KEY=...                   # dashboard.cohere.com

# STT — Modo Fantasma (ADR-0016: Deepgram Nova, batch + diarizacion)
DEEPGRAM_API_KEY=...                    # console.deepgram.com. Requerida para POST /athos/transcribe
STT_MODEL=nova-2                        # modelo de Deepgram; espanol + diarize se fijan en codigo

CORS_ORIGINS=http://localhost:3000
APP_ENV=dev
