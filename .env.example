# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del front (Next.js). Copiá este archivo a `.env.local`.
#
# Cada bloque dice QUÉ SE ROMPE si falta, porque no todas son obligatorias: el
# núcleo clínico arranca con las 4 primeras y el resto habilita módulos.
#
# El backend Athos tiene las suyas aparte: athos-service/.env.example
#
# Las `NEXT_PUBLIC_*` se embeben en el bundle del navegador — NUNCA poner un
# secreto ahí. Las demás sólo existen del lado del servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBLIGATORIAS: sin estas la app no arranca ────────────────────────────────

# Supabase. Del panel: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave `service_role` de Supabase. **SE SALTA TODA LA RLS**: es la llave maestra
# de la base, no la expongas ni la pongas en una variable NEXT_PUBLIC_.
# Si falta: `createAdminClient()` lanza excepción → las 7 acciones de escritura
# del agente y TODO el ciclo de aprobación fallan en caliente.
SUPABASE_SERVICE_ROLE_KEY=

# Backend Athos (FastAPI en Railway). Sin esto, el chat clínico y la búsqueda de
# literatura del agente devuelven error.
NEXT_PUBLIC_ATHOS_URL=https://athos-service-production.up.railway.app

# ── IA del agente del front ──────────────────────────────────────────────────

# El agente con herramientas, la sugerencia de WhatsApp y la lectura de
# documentos usan Anthropic por defecto. La lee el SDK `@ai-sdk/anthropic`
# directamente del entorno, así que no aparece en el código.
# Si falta: el asistente de /dashboard/asistente queda caído.
ANTHROPIC_API_KEY=

# Modelo por rol. Vacío = el default del código (claude-sonnet-5 para el agente,
# claude-haiku-4-5 para el modo auto y la visión). Nunca hay un modelo hardcodeado.
ATHOS_AGENT_PROVIDER=anthropic
ATHOS_AGENT_MODEL=
ATHOS_AUTO_PROVIDER=
ATHOS_AUTO_MODEL=
ATHOS_VISION_MODEL=

# CASCADA ENTRE PROVEEDORES (cláusula 1.4). Formato `modelo@proveedor,…` en orden
# de preferencia — el MISMO que usa athos-service, para no tener dos dialectos.
#
# Vacía = un solo proveedor, exactamente el comportamiento de siempre; la cascada
# es aditiva y apagarla devuelve el sistema a como estaba. Si está puesta, MANDA
# sobre el par ATHOS_*_PROVIDER / ATHOS_*_MODEL de esa superficie.
#
# Por qué importa: el 2026-07-31 la cuenta de Anthropic se quedó sin crédito y el
# asistente se cayó entero, mientras el chat clínico —que sí tenía cascada— siguió
# respondiendo. Se cae al respaldo ANTES del primer token, nunca a mitad de
# respuesta, y sólo ante fallos DEL PROVEEDOR (saldo, cuota, credencial, 429/503,
# timeouts): un error nuestro no se reintenta porque fallaría igual en el segundo.
#
#   ATHOS_AGENT_CASCADE  → agente con herramientas y sugerencias de WhatsApp
#   ATHOS_AUTO_CASCADE   → modo auto de WhatsApp (le responde al CLIENTE)
#   ATHOS_VISION_CASCADE → lectura de facturas y recetas (sólo modelos con visión)
ATHOS_AGENT_CASCADE=
ATHOS_AUTO_CASCADE=
ATHOS_VISION_CASCADE=

# Sólo si se apunta algún rol a DeepSeek (ATHOS_*_PROVIDER=deepseek, o cualquier
# entrada `…@deepseek` de una cascada).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Igual para Gemini: hace falta si alguna cascada nombra `…@google` (el proveedor
# se llama `google`, no `gemini`). Se llama GEMINI_API_KEY y no GOOGLE_* para usar
# el MISMO nombre que athos-service en Railway — es la misma cuenta.
# `GOOGLE_CLIENT_ID`/`SECRET` son del OAuth de Calendar y no tienen nada que ver.
# Faltaba acá y en /api/health, así que una cascada con Gemini sin credencial
# reportaba ok:true.
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ── Tareas programadas (crons de Vercel) ─────────────────────────────────────

# Secreto compartido de los dos crons. Generalo con: openssl rand -base64 32
# Si falta: /api/cron/purge-audio y /api/cron/cartera devuelven 503. Ojo, la
# purga es la que borra el audio de consultas a los 4 días — sin ella se
# INCUMPLE la retención de la Ley 1581 en silencio.
CRON_SECRET=

# ── URLs base ────────────────────────────────────────────────────────────────

# Para armar enlaces absolutos en correos y WhatsApp. En Vercel cae a la URL del
# deployment; en local hay que ponerla o los links del correo apuntan mal.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# La usan el webhook de Evolution y el retorno de Kapso. En producción:
# https://tuvetia.vercel.app (SIN barra final).
# OJO: el retorno de Kapso la lee con `??`, así que definirla EN BLANCO gana al
# fallback y rompe el redirect. O tiene valor, o no se define.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Calendar (opcional, UNA cuenta por clínica: la del admin) ─────────
# Si faltan: el botón "Conectar Google Calendar" no funciona. El calendario
# interno sigue operando normal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outlook/Microsoft Calendar (opcional, UNA cuenta por clínica) ────────────
# Del App Registration en Azure Portal (Certificates & secrets para el secret).
# Si faltan: el botón "Conectar Outlook Calendar" no funciona. El calendario
# interno sigue operando normal.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant del App Registration: "common" (cuentas personales + de trabajo/escuela,
# default), "organizations" (solo trabajo/escuela) o el Tenant ID si el App
# Registration es single-tenant. Debe coincidir con el proveedor Azure configurado
# en Supabase Auth.
MICROSOFT_TENANT_ID=common

# ── Correo transaccional (Resend) ────────────────────────────────────────────
# De acá salen las FACTURAS, los recordatorios de cobranza y toda notificación que Tuvetia
# le manda a un cliente en nombre de una clínica. El remitente es siempre el mismo; el nombre
# visible es el de la clínica y el Reply-To sus administradores. Ver CORREOS.md.
#
# Si falta RESEND_API_KEY: las facturas no salen por correo y el canal EMAIL de cobranza queda
# deshabilitado (el mensaje de error lo dice; no falla en silencio).
#
# ANTES DEL PRIMER ENVÍO: verificar el dominio en Resend (SPF y DKIM de tuvetia.com). Sin eso
# Resend rechaza todo con "domain is not verified".
RESEND_API_KEY=
TRANSACTIONAL_FROM_EMAIL=vet@tuvetia.com
# Nombre visible de los correos de PLATAFORMA (los de /admin a los veterinarios). Los de clínica
# usan el nombre de la clínica, no este.
PLATFORM_FROM_NAME=Tuvetia

# ── Correo de Athos (Composio) ───────────────────────────────────────────────
# La cuenta de Google que conecta CADA MIEMBRO desde Conexiones. Es la que Athos usa para leer y
# escribir correo por esa persona. Ver CORREOS.md.
#
# Si faltan: la sección de correo de Conexiones muestra que no está disponible, y las herramientas
# de correo de Athos responden que la cuenta no está conectada (no fallan en silencio).
COMPOSIO_API_KEY=
# Del dashboard de Composio → Auth Configs → Gmail. No es secreto.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_9em2oPUx5SjK
# Versión del toolkit de Gmail. Ejecutar una tool a mano EXIGE una versión con fecha ("latest" no
# sirve). Solo se define para probar una versión nueva sin desplegar; el default está en el código.
# COMPOSIO_GMAIL_TOOLKIT_VERSION=20260721_00

# ── WhatsApp ─────────────────────────────────────────────────────────────────

# Cifra el token de cada clínica antes de guardarlo (AES-256-GCM).
# 32 bytes en base64: openssl rand -base64 32
# Obligatoria si algún tenant usa Meta directo; sin ella el envío lanza excepción.
WHATSAPP_TOKEN_KEY=

# Qué proveedor ofrece la UI de conexión: evolution | (vacío = Kapso)
# Ojo: con esto vacío y sin las de Meta, el flujo REDIRIGE FUERA de la plataforma.
NEXT_PUBLIC_WA_PROVIDER=

# --- Meta / WhatsApp Cloud API (conexión oficial, embebida en la app) ---
# Requiere App Review de Meta aprobado. Sin las NEXT_PUBLIC_* el botón embebido
# no aparece.
# ORIGEN: developers.facebook.com -> tu App -> Configuración -> Básica
META_APP_ID=
# ORIGEN: misma pantalla, "Clave secreta de la aplicación" (botón Mostrar). SECRETO.
META_APP_SECRET=
# ORIGEN: la INVENTÁS vos (cadena aleatoria). El MISMO valor se pega en
# Meta -> WhatsApp -> Configuración -> Webhooks -> "Token de verificación".
META_WEBHOOK_VERIFY_TOKEN=
# PIN de verificación en dos pasos del número. El código default-ea a "000000":
# ponelo de verdad antes de conectar un número real.
META_REGISTER_PIN=
# ORIGEN: el mismo valor que META_APP_ID (el App ID no es secreto).
NEXT_PUBLIC_META_APP_ID=
# ORIGEN: App -> WhatsApp -> Embedded Signup -> crear configuración -> config_id
NEXT_PUBLIC_META_ES_CONFIG_ID=

# --- Evolution API (Baileys — PROTOCOLO NO OFICIAL, riesgo de baneo) ---
# NO es un SaaS: no hay cuenta ni panel de terceros. Es un contenedor Docker que
# desplegás vos (Railway). Paso a paso en docs/EVOLUTION.md y en
# docs/CONFIGURACION-PRODUCCION.md.
# ORIGEN: el subdominio público que Railway le asigna a ESE contenedor.
EVOLUTION_BASE_URL=
# ORIGEN: la INVENTÁS vos. Debe ser IDÉNTICA a AUTHENTICATION_API_KEY del
# contenedor de Evolution — es la contraseña entre tuvetia y ese servidor.
EVOLUTION_API_KEY=
# ORIGEN: la autogenerás (openssl rand -hex 32). Es el segmento secreto de la URL
# del webhook: Evolution NO firma sus llamadas, así que este token ES la auth.
EVOLUTION_WEBHOOK_TOKEN=

# --- Kapso (legado, en retirada) ---
# ORIGEN: app.kapso.ai -> API keys. Solo si queda algún tenant en Kapso.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# ── Varios ───────────────────────────────────────────────────────────────────

# Correos con acceso al panel /admin, separados por coma.
PLATFORM_ADMIN_EMAILS=

# Kill-switch de cobranza: con "1" el motor de cartera NO envía nada real.
# Útil para probar el módulo sin escribirle a un cliente.
CARTERA_MESSAGING_SIMULATED=
